# Backend bind address inside the rtstt container
BACKEND_HOST=0.0.0.0
BACKEND_PORT=9001

# Ports published on the host
BACKEND_PUBLISH_PORT=9001
FRONTEND_PUBLISH_PORT=8081

# URL the browser uses to reach the WebSocket backend
# Local Docker default:
BACKEND_WS_URL=ws://localhost:9001

# Optional public frontend URL (documentation / clients)
FRONTEND_URL=http://localhost:8081
